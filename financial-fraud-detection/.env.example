# .env.example
# Copy this file to `.env` and fill in real values. Never commit the real `.env` file.

# --- Alerting ---
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL=
ALERT_EMAIL_PASSWORD=
ALERT_RECEIVER=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
ALERT_RISK_SCORE_THRESHOLD=61

# Note: if using Gmail, ALERT_EMAIL_PASSWORD must be a Gmail "App Password"
# (Google Account -> Security -> 2-Step Verification -> App Passwords),
# NOT your normal Gmail password.

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Simulator ---
SIMULATOR_DELAY_SECONDS=1.0

# --- Logging ---
LOG_LEVEL=INFO
